diff --git a/launcher/app/src/test/java/com/gathin/tvhome/PrayerTimesTest.java b/launcher/app/src/test/java/com/gathin/tvhome/PrayerTimesTest.java
new file mode 100644
index 0000000..cbd662a
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/PrayerTimesTest.java
@@ -0,0 +1,96 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertThrows;
+import static org.junit.Assert.assertTrue;
+
+import org.json.JSONException;
+import org.junit.Test;
+
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+import java.util.List;
+
+/** Against a real e-Solat response (zone KDH01, October 2026, saved as it came from www.e-solat.gov.my). */
+public class PrayerTimesTest {
+    private static List<PrayerTimes.Day> days() throws Exception {
+        try (InputStream in = PrayerTimesTest.class.getResourceAsStream("/esolat-kdh01-2026-10.json")) {
+            assertNotNull(in);
+            return PrayerTimes.parse(new String(in.readAllBytes(), StandardCharsets.UTF_8));
+        }
+    }
+
+    @Test public void parsesEveryDayOfTheMonth() throws Exception {
+        List<PrayerTimes.Day> days = days();
+        assertEquals(31, days.size());
+        PrayerTimes.Day first = days.get(0);
+        assertEquals(LocalDate.of(2026, 10, 1), first.date);
+        assertEquals("1448-04-19", first.hijri);
+        assertEquals(PrayerTimes.KEYS.length, first.times.size());
+        assertEquals(LocalTime.of(5, 48), first.times.get(0));
+        assertEquals(LocalTime.of(20, 20), first.times.get(6));
+    }
+
+    @Test public void afternoonNextIsAsar() throws Exception {
+        PrayerTimes.State s = PrayerTimes.at(days(), LocalDateTime.of(2026, 10, 28, 13, 26));
+        assertEquals(4, s.next);
+        assertTrue(s.nextIsToday);
+        assertEquals(LocalTime.of(16, 24), s.nextTime);
+        assertEquals(Duration.ofHours(2).plusMinutes(58), s.untilNext);
+        assertEquals("1448-05-17", s.today.hijri);
+    }
+
+    @Test public void atExactlyATimeTheNextOneIsAfterIt() throws Exception {
+        assertEquals(5, PrayerTimes.at(days(), LocalDateTime.of(2026, 10, 28, 16, 24)).next);
+    }
+
+    @Test public void beforeImsakNextIsImsak() throws Exception {
+        PrayerTimes.State s = PrayerTimes.at(days(), LocalDateTime.of(2026, 10, 28, 3, 0));
+        assertEquals(0, s.next);
+        assertTrue(s.nextIsToday);
+    }
+
+    @Test public void afterIsyakNextIsTomorrowsImsak() throws Exception {
+        List<PrayerTimes.Day> days = days();
+        PrayerTimes.State s = PrayerTimes.at(days, LocalDateTime.of(2026, 10, 28, 23, 0));
+        assertEquals(0, s.next);
+        assertFalse(s.nextIsToday);
+        assertEquals(days.get(28).times.get(0), s.nextTime);   // 29 October
+        assertEquals(Duration.between(LocalDateTime.of(2026, 10, 28, 23, 0),
+                LocalDateTime.of(2026, 10, 29, s.nextTime.getHour(), s.nextTime.getMinute())), s.untilNext);
+    }
+
+    @Test public void afterTheLastDayThereIsNoNext() throws Exception {
+        PrayerTimes.State s = PrayerTimes.at(days(), LocalDateTime.of(2026, 10, 31, 23, 0));
+        assertEquals(-1, s.next);
+        assertNull(s.nextTime);
+    }
+
+    @Test public void dayOutsideTheDataHasNoState() throws Exception {
+        assertNull(PrayerTimes.at(days(), LocalDateTime.of(2026, 11, 2, 12, 0)));
+    }
+
+    @Test public void readsMalayMonthNames() throws Exception {
+        assertEquals(LocalDate.of(2026, 3, 5), PrayerTimes.date("05-Mac-2026"));
+        assertEquals(LocalDate.of(2026, 5, 5), PrayerTimes.date("05-Mei-2026"));
+        assertEquals(LocalDate.of(2026, 8, 31), PrayerTimes.date("31-Ogos-2026"));
+        assertEquals(LocalDate.of(2026, 12, 1), PrayerTimes.date("01-Dis-2026"));
+        assertThrows(JSONException.class, () -> PrayerTimes.date("01-Xyz-2026"));
+    }
+
+    @Test public void refusesAnythingButASuccessfulResponse() {
+        assertThrows(JSONException.class, () -> PrayerTimes.parse(
+                "{\"prayerTime\":{\"data\":[\"No data available for the current request\"]},\"status\":\"NO_RECORD!\"}"));
+        assertThrows(JSONException.class, () -> PrayerTimes.parse("<html>Error 404</html>"));
+        assertThrows(JSONException.class, () -> PrayerTimes.parse("{\"prayerTime\":[],\"status\":\"OK!\"}"));
+        assertThrows(JSONException.class, () -> PrayerTimes.parse(
+                "{\"prayerTime\":[{\"date\":\"01-Okt-2026\",\"hijri\":\"1448-04-19\"}],\"status\":\"OK!\"}"));
+    }
+}
