@@ -0,0 +1,19 @@
+package com.gathin.tvhome;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+
+/**
+ * Sets the JAKIM zone of the prayer-times panel; CleanTV sends it over adb. Only callers holding
+ * WRITE_SECURE_SETTINGS can (the adb shell has it, ordinary apps cannot). An empty zone clears it.
+ * {@code adb shell am broadcast -n <package>/com.gathin.tvhome.PrayerConfig --es zone KDH01}
+ */
+public class PrayerConfig extends BroadcastReceiver {
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        String zone = intent.getStringExtra("zone");
+        if (zone != null) PrayerStore.setZone(context, zone);
+        setResultData("zone=" + PrayerStore.zone(context));
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/PrayerPanel.java b/launcher/app/src/main/java/com/gathin/tvhome/PrayerPanel.java
new file mode 100644
index 0000000..d783455
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/PrayerPanel.java
@@ -0,0 +1,150 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.os.SystemClock;
+import android.text.SpannableString;
+import android.text.Spanned;
+import android.text.style.ForegroundColorSpan;
+import android.text.style.RelativeSizeSpan;
+import android.view.View;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+import java.time.ZoneId;
+import java.time.format.DateTimeFormatter;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * The prayer-times panel under the clock, after the race-weekend panel: text only, redrawn once a minute with
+ * the clock and never animated. Shown only while a zone is set and the settings switch is on; the year for the
+ * zone is downloaded once and kept, so the panel keeps working offline, and a failed download is tried again
+ * no sooner than {@link #RETRY_MS}.
+ */
+final class PrayerPanel {
+
+    private static final ZoneId MALAYSIA = ZoneId.of("Asia/Kuala_Lumpur");
+    private static final long RETRY_MS = 30 * 60_000L;
+    /** With nothing to show (Home starts before Wi-Fi is up) the panel tries again sooner. */
+    private static final long RETRY_EMPTY_MS = 2 * 60_000L;
+    private static final int GREEN = 0xFF3DDC97;
+
+    private final Activity activity;
+    private final View panel, racePanel;
+    private final TextView place, date, headline, footer;
+    private final LinearLayout cells;
+    private List<PrayerTimes.Day> days;
+    private String daysZone = "";
+    private boolean fetching;
+    private long lastAttempt = -RETRY_MS;
+
+    PrayerPanel(Activity activity, View racePanel) {
+        this.activity = activity;
+        this.racePanel = racePanel;
+        panel = activity.findViewById(R.id.prayerPanel);
+        place = activity.findViewById(R.id.prayerPlace);
+        date = activity.findViewById(R.id.prayerDate);
+        headline = activity.findViewById(R.id.prayerHeadline);
+        footer = activity.findViewById(R.id.prayerFooter);
+        cells = activity.findViewById(R.id.prayerTimes);
+        ((TextView) activity.findViewById(R.id.prayerKicker)).setText(R.string.prayer_kicker);
+        for (int i = 0; i < PrayerTimes.KEYS.length; i++) {
+            TextView cell = new TextView(activity);
+            cell.setMaxLines(2);   // not singleLine: that would turn the line break between name and time into a space
+            cell.setTextSize(11);
+            cell.setLetterSpacing(0.08f);
+            cell.setLineSpacing(0, 0.95f);
+            cell.setIncludeFontPadding(false);
+            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT);
+            lp.setMarginEnd(Math.round(18 * activity.getResources().getDisplayMetrics().density));
+            cells.addView(cell, lp);
+        }
+    }
+
+    /** Redraws for this minute, and starts a download when the zone has no usable data. */
+    void update() {
+        String zone = PrayerStore.zone(activity);
+        // The race-weekend panel has the same place; it is rare and only shown for a few hours, so it wins.
+        if (zone.isEmpty() || PrayerStore.hidden(activity) || racePanel.getVisibility() == View.VISIBLE) {
+            panel.setVisibility(View.GONE);
+            return;
+        }
+        if (!zone.equals(daysZone)) {
+            days = PrayerStore.cached(activity, zone);
+            daysZone = zone;
+            lastAttempt = -RETRY_MS;   // a newly chosen zone is fetched at once, whatever happened to the last one
+        }
+        long age = System.currentTimeMillis() - PrayerStore.cachedAt(activity, zone);
+        if (!fetching && (days == null || age > PrayerStore.REFRESH_MS || days.get(days.size() - 1).date.isBefore(LocalDateTime.now(MALAYSIA).toLocalDate()))
+                && SystemClock.elapsedRealtime() - lastAttempt >= (days == null ? RETRY_EMPTY_MS : RETRY_MS)) {
+            fetch(zone);
+        }
+        draw(zone);
+        panel.setVisibility(View.VISIBLE);
+    }
+
+    private void fetch(String zone) {
+        fetching = true;
+        lastAttempt = SystemClock.elapsedRealtime();
+        new Thread(() -> {
+            List<PrayerTimes.Day> fresh = PrayerStore.download(activity, zone, System.currentTimeMillis());
+            activity.runOnUiThread(() -> {
+                fetching = false;
+                if (fresh != null && zone.equals(daysZone)) days = fresh;
+                if (!activity.isDestroyed()) update();
+            });
+        }, "prayer-times").start();
+    }
+
+    private void draw(String zone) {
+        String[] entry = zoneEntry(zone);
+        place.setText(entry == null ? zone : activity.getString(R.string.prayer_place, entry[1], entry[2]));
+        footer.setText(activity.getString(R.string.prayer_footer, zone));
+        LocalDateTime now = LocalDateTime.now(MALAYSIA);
+        PrayerTimes.State s = days == null ? null : PrayerTimes.at(days, now);
+        if (s == null) {
+            date.setVisibility(View.GONE);
+            cells.setVisibility(View.GONE);
+            headline.setText(R.string.prayer_no_data);
+            headline.setTextSize(14);
+            return;
+        }
+        date.setVisibility(View.VISIBLE);
+        cells.setVisibility(View.VISIBLE);
+        headline.setTextSize(20);
+        DateTimeFormatter day = DateTimeFormatter.ofPattern("EEEE, d MMM yyyy", Locale.getDefault());
+        String hijri = PrayerTimes.hijri(activity.getResources(), s.today.hijri);
+        date.setText(hijri.isEmpty() ? day.format(s.today.date) : activity.getString(R.string.prayer_dates, day.format(s.today.date), hijri));
+        DateTimeFormatter clock = DateTimeFormatter.ofPattern(
+                android.text.format.DateFormat.is24HourFormat(activity) ? "HH:mm" : "h:mm", Locale.getDefault());
+        String[] names = activity.getResources().getStringArray(R.array.prayer_names);
+        if (s.next >= 0) {
+            headline.setText(activity.getString(R.string.prayer_next, names[s.next], clock.format(s.nextTime),
+                    RaceWeekend.countdown(activity.getResources(), s.untilNext)));
+        } else {
+            headline.setText("");
+        }
+        for (int i = 0; i < cells.getChildCount(); i++) {
+            LocalTime t = s.today.times.get(i);
+            boolean next = s.nextIsToday && i == s.next;
+            SpannableString text = new SpannableString(names[i] + "\n" + clock.format(t));
+            int split = names[i].length() + 1;
+            text.setSpan(new RelativeSizeSpan(1.6f), split, text.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+            // Done times fade, the next one is bright and green, the rest sit in between.
+            int color = next ? GREEN : t.isBefore(now.toLocalTime()) ? 0x47FFFFFF : 0xCCFFFFFF;
+            text.setSpan(new ForegroundColorSpan(color), 0, text.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+            ((TextView) cells.getChildAt(i)).setText(text);
+        }
+    }
+
+    /** {code, area, state} for a zone, from res/values/prayer_zones.xml; null for a code that is not listed. */
+    private String[] zoneEntry(String zone) {
+        for (String item : activity.getResources().getStringArray(R.array.prayer_zones)) {
+            String[] part = item.split("[|]");
+            if (part.length == 3 && part[0].equals(zone)) return part;
+        }
+        return null;
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/PrayerStore.java b/launcher/app/src/main/java/com/gathin/tvhome/PrayerStore.java
new file mode 100644
index 0000000..b17d702
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/PrayerStore.java
@@ -0,0 +1,102 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.regex.Pattern;
+
+/**
+ * The prayer-times zone, the switch that hides the panel, and the downloaded year for that zone. The zone comes
+ * from CleanTV (PrayerConfig); the one network use is the e-Solat request below, which carries the zone code
+ * and nothing else.
+ */
+final class PrayerStore {
+
+    static final String PREFS = "prayer_times";
+    static final Pattern ZONE = Pattern.compile("[A-Z]{3}[0-9]{2}");
+    private static final String ZONE_KEY = "zone", HIDDEN_KEY = "hidden", CACHE_KEY = "year_json",
+            CACHE_ZONE_KEY = "year_zone", CACHE_AT_KEY = "year_at";
+    private static final String API = "https://www.e-solat.gov.my/index.php?r=esolatApi/takwimsolat&period=year&zone=";
+    private static final int MAX_BYTES = 1 << 20;
+    /** JAKIM can revise a month; a week-old year is fetched again when the network is there. */
+    static final long REFRESH_MS = 7L * 24 * 3_600_000;
+
+    private PrayerStore() {
+    }
+
+    private static SharedPreferences prefs(Context ctx) {
+        return ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    /** The saved zone, or "" when none is set. */
+    static String zone(Context ctx) {
+        return prefs(ctx).getString(ZONE_KEY, "");
+    }
+
+    /** Saves a zone code, or clears it with "". False for anything that is not a zone code. */
+    static boolean setZone(Context ctx, String zone) {
+        if (zone == null || !(zone.isEmpty() || ZONE.matcher(zone).matches())) return false;
+        prefs(ctx).edit().putString(ZONE_KEY, zone).apply();
+        return true;
+    }
+
+    static boolean hidden(Context ctx) {
+        return prefs(ctx).getBoolean(HIDDEN_KEY, false);
+    }
+
+    static void setHidden(Context ctx, boolean hidden) {
+        prefs(ctx).edit().putBoolean(HIDDEN_KEY, hidden).apply();
+    }
+
+    /** The saved year for {@code zone}, or null when none (or an unreadable one) is stored. */
+    static List<PrayerTimes.Day> cached(Context ctx, String zone) {
+        SharedPreferences p = prefs(ctx);
+        String json = p.getString(CACHE_KEY, null);
+        if (json == null || !zone.equals(p.getString(CACHE_ZONE_KEY, ""))) return null;
+        try {
+            return PrayerTimes.parse(json);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    static long cachedAt(Context ctx, String zone) {
+        SharedPreferences p = prefs(ctx);
+        return zone.equals(p.getString(CACHE_ZONE_KEY, "")) ? p.getLong(CACHE_AT_KEY, 0) : 0;
+    }
+
+    /** Downloads the year for {@code zone} (blocking: call off the main thread) and keeps it. Null when it failed. */
+    static List<PrayerTimes.Day> download(Context ctx, String zone, long nowMs) {
+        if (!ZONE.matcher(zone).matches()) return null;
+        HttpURLConnection c = null;
+        try {
+            c = (HttpURLConnection) new URL(API + zone).openConnection();
+            c.setConnectTimeout(8000);
+            c.setReadTimeout(15000);
+            c.setRequestProperty("User-Agent", "CleanTV-Home");
+            if (c.getResponseCode() != 200) return null;
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            try (InputStream in = c.getInputStream()) {
+                byte[] buf = new byte[8192];
+                for (int n; (n = in.read(buf)) > 0; ) {
+                    out.write(buf, 0, n);
+                    if (out.size() > MAX_BYTES) return null;
+                }
+            }
+            String json = new String(out.toByteArray(), StandardCharsets.UTF_8);
+            List<PrayerTimes.Day> days = PrayerTimes.parse(json);
+            prefs(ctx).edit().putString(CACHE_KEY, json).putString(CACHE_ZONE_KEY, zone).putLong(CACHE_AT_KEY, nowMs).apply();
+            return days;
+        } catch (Exception e) {
+            return null;
+        } finally {
+            if (c != null) c.disconnect();
+        }
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/PrayerTimes.java b/launcher/app/src/main/java/com/gathin/tvhome/PrayerTimes.java
new file mode 100644
index 0000000..6dca349
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/PrayerTimes.java
@@ -0,0 +1,126 @@
+package com.gathin.tvhome;
+
+import android.content.res.Resources;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.time.Duration;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Prayer times for one JAKIM zone, from the official e-Solat API (takwimsolat, period=year). The times are
+ * Malaysian time and are read as such, whatever zone the TV's own clock is set to. Parsing and scheduling are
+ * plain Java, tested on the JVM against a saved real response; display labels use Android resources.
+ */
+final class PrayerTimes {
+
+    /** Imsak, Subuh, Syuruk, Zohor, Asar, Maghrib, Isyak: the keys of one day in the API response. */
+    static final String[] KEYS = {"imsak", "fajr", "syuruk", "dhuhr", "asr", "maghrib", "isha"};
+    private static final String[] MONTHS = {"Jan", "Feb", "Mac", "Apr", "Mei", "Jun", "Jul", "Ogos", "Sep", "Okt", "Nov", "Dis"};
+
+    static final class Day {
+        final LocalDate date;
+        /** As written by JAKIM, for example 1448-05-17 (year-month-day of the Hijri calendar). */
+        final String hijri;
+        /** In the order of {@link #KEYS}. */
+        final List<LocalTime> times;
+
+        Day(LocalDate date, String hijri, List<LocalTime> times) {
+            this.date = date;
+            this.hijri = hijri;
+            this.times = Collections.unmodifiableList(new ArrayList<>(times));
+        }
+    }
+
+    /** What the panel shows at one moment. */
+    static final class State {
+        final Day today;
+        /** Index in {@link #KEYS} of the next time, counted from today's list or tomorrow's when today is over. */
+        final int next;
+        final boolean nextIsToday;
+        final LocalTime nextTime;
+        final Duration untilNext;
+
+        State(Day today, int next, boolean nextIsToday, LocalTime nextTime, Duration untilNext) {
+            this.today = today;
+            this.next = next;
+            this.nextIsToday = nextIsToday;
+            this.nextTime = nextTime;
+            this.untilNext = untilNext;
+        }
+    }
+
+    private PrayerTimes() {
+    }
+
+    /** Every day of the response, oldest first. Anything but a complete, successful response is an error. */
+    static List<Day> parse(String json) throws JSONException {
+        JSONObject root = new JSONObject(json);
+        if (!"OK!".equals(root.optString("status"))) throw new JSONException("status: " + root.optString("status"));
+        JSONArray array = root.getJSONArray("prayerTime");
+        List<Day> days = new ArrayList<>();
+        for (int i = 0; i < array.length(); i++) {
+            JSONObject o = array.getJSONObject(i);
+            List<LocalTime> times = new ArrayList<>();
+            for (String key : KEYS) times.add(LocalTime.parse(o.getString(key)));
+            days.add(new Day(date(o.getString("date")), o.optString("hijri"), times));
+        }
+        if (days.isEmpty()) throw new JSONException("no days");
+        days.sort((a, b) -> a.date.compareTo(b.date));
+        return days;
+    }
+
+    /** "01-Okt-2026", with the Malay month abbreviations the API uses. */
+    static LocalDate date(String text) throws JSONException {
+        String[] part = text.split("-");
+        try {
+            if (part.length == 3) {
+                for (int m = 0; m < MONTHS.length; m++) {
+                    if (MONTHS[m].equalsIgnoreCase(part[1])) {
+                        return LocalDate.of(Integer.parseInt(part[2]), m + 1, Integer.parseInt(part[0]));
+                    }
+                }
+            }
+        } catch (RuntimeException e) {
+            // falls through to the error below
+        }
+        throw new JSONException("date: " + text);
+    }
+
+    /** The next time after {@code now} (Malaysian local time), or null when the data ends with today. */
+    static State at(List<Day> days, LocalDateTime now) {
+        Day today = null, tomorrow = null;
+        for (Day d : days) {
+            if (d.date.equals(now.toLocalDate())) today = d;
+            else if (d.date.equals(now.toLocalDate().plusDays(1))) tomorrow = d;
+        }
+        if (today == null) return null;
+        for (int i = 0; i < KEYS.length; i++) {
+            LocalTime t = today.times.get(i);
+            if (now.toLocalTime().isBefore(t)) {
+                return new State(today, i, true, t, Duration.between(now, now.toLocalDate().atTime(t)));
+            }
+        }
+        if (tomorrow == null) return new State(today, -1, false, null, null);
+        LocalTime t = tomorrow.times.get(0);
+        return new State(today, 0, false, t, Duration.between(now, tomorrow.date.atTime(t)));
+    }
+
+    /** "17 Jamadilawal 1448H" from "1448-05-17"; empty when JAKIM sent something else. */
+    static String hijri(Resources res, String hijri) {
+        String[] p = hijri.split("-");
+        try {
+            return res.getString(R.string.prayer_hijri_date, Integer.parseInt(p[2]),
+                    res.getStringArray(R.array.prayer_hijri_months)[Integer.parseInt(p[1]) - 1], Integer.parseInt(p[0]));
+        } catch (RuntimeException e) {
+            return "";
+        }
+    }
+}
